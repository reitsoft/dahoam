			>
				{speichernLaeuft ? 'Speichert...' : 'Termin speichern'}
			</button>
		</div>
	{/if}

	<!-- Terminliste -->
	<div class="flex flex-1 flex-col gap-2 overflow-y-auto px-3 py-3">
